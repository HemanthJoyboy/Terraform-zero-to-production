# Read by docker-compose.yml (not by the app code) for two things:
# 1. VITE_API_BASE_URL - the client build arg (see client/Dockerfile)
# 2. POSTGRES_* - used to bootstrap the postgres container's admin user/db
#    on its FIRST startup only (see README Section "Postgres container
#    authentication" for what these actually do)
VITE_API_BASE_URL=http://localhost:4000

POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=tododb
