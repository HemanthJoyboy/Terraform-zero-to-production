PORT=4002
# Same DATABASE_URL as auth-service - both services share one Postgres
# container/database, just different tables (see sql/schema.sql in each).
DATABASE_URL=postgres://todo:todo@postgres:5432/tododb
# CHANGE THIS: MUST be identical to auth-service's JWT_SECRET (so tokens issued by auth-service verify here)
JWT_SECRET=change_this_to_a_long_random_secret
