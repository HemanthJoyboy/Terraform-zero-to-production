PORT=4001
# Points at the `postgres` container by service/container name (not localhost,
# not an IP) - matches the POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB you set
# for the postgres container itself (root .env.example / docker-compose.yml).
DATABASE_URL=postgres://todo:todo@postgres:5432/tododb
# CHANGE THIS: long random secret, MUST match todo-service's JWT_SECRET
JWT_SECRET=change_this_to_a_long_random_secret
